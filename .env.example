APP_NAME="SOENAC API"
APP_VERSION=" v2.0"
APP_KEY=
APP_DEBUG=true
APP_PORT=8000
APP_URL=http://127.0.0.1:${APP_PORT}

# true = SendBillSync; false = SendBillAsync (por defecto)
DIAN_USE_SYNC=false

# Debug DIAN: editar manualmente config/dian_debug.php (preview / verbose / include_xml / memory_limit)
# Límite PHP para facturas grandes (si el servidor tiene 32M, subir aquí o en dian_debug.php)
DIAN_MEMORY_LIMIT=512M

# Clave para limpiar caché desde el navegador (sin terminal)
# GET /api/ubl2.1/maintenance/clear-cache?key=TU_CLAVE
# GET /clear-cache?key=TU_CLAVE
DIAN_CACHE_CLEAR_KEY=proh2024

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=api
DB_USERNAME=root
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MYSQL_DATABASE=api
MYSQL_USER=api
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=secret
